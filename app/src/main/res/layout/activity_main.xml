<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--顶部 Lab 1-->
    <TextView
        android:id="@+id/tvLab1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lab 1"
        android:textSize="20sp"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--白色块 Responsive Layout 1-->
    <TextView
        android:id="@+id/tvWhiteBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Responsive Layout 1"
        android:textSize="18sp"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvLab1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--水平Chain链，4个彩色TextView，权重都为1实现四等分，不嵌套LinearLayout-->
    <TextView
        android:id="@+id/tvThis"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:text="This"
        android:gravity="center"
        android:background="#ff0000"
        app:layout_constraintTop_toBottomOf="@id/tvWhiteBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvIs"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread_inside"/>

    <TextView
        android:id="@+id/tvIs"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:text="is"
        android:gravity="center"
        android:background="#0000ff"
        app:layout_constraintTop_toBottomOf="@id/tvWhiteBlock"
        app:layout_constraintStart_toEndOf="@id/tvThis"
        app:layout_constraintEnd_toStartOf="@id/tvMy"
        app:layout_constraintHorizontal_weight="1"/>

    <TextView
        android:id="@+id/tvMy"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:text="my"
        android:gravity="center"
        android:background="#8040b0"
        app:layout_constraintTop_toBottomOf="@id/tvWhiteBlock"
        app:layout_constraintStart_toEndOf="@id/tvIs"
        app:layout_constraintEnd_toStartOf="@id/tvFirst"
        app:layout_constraintHorizontal_weight="1"/>

    <TextView
        android:id="@+id/tvFirst"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:text="first"
        android:gravity="center"
        android:background="#ffff00"
        app:layout_constraintTop_toBottomOf="@id/tvWhiteBlock"
        app:layout_constraintStart_toEndOf="@id/tvMy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!--黑色大区域 Android Application，占剩余全部垂直空间-->
    <TextView
        android:id="@+id/tvBlackArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="Android Application"
        android:textSize="18sp"
        android:gravity="center"
        android:background="#000000"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvFirst"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--底部两个按钮区域，使用Constraint约束居中-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChangeCon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change"
            android:backgroundTint="#7b68bb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCancelCon"
            app:layout_constraintHorizontal_chainStyle="packed"/>

        <Button
            android:id="@+id/btnCancelCon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="#7b68bb"
            app:layout_constraintStart_toEndOf="@id/btnChangeCon"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
